# Copy to .env.local only after creating your own Supabase project.
# The URL and publishable/anon key are public browser config, not server secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional. If Supabase is not configured, the front end uses the local demo API/data.
# VITE_CONTENT_API_URL=/api/v1
